<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VerticeMobile.SettingsPage"
             Title="Ajustes de Conexión">

    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

        <Label Text="Servidor Local" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />

        <Label Text="Ingrese la IP de la computadora donde está el sistema de escritorio (Ej: 192.168.0.15):" FontSize="14" TextColor="Gray" HorizontalTextAlignment="Center" />

        <Entry x:Name="txtIpAddress" Placeholder="Ej: 192.000.0.00" Keyboard="Telephone" HorizontalTextAlignment="Center" FontSize="18"/>

        <Button Text="Guardar Configuración" Clicked="OnSaveClicked" BackgroundColor="#1976D2" TextColor="White" Margin="0,20,0,0"/>

    </VerticalStackLayout>

</ContentPage>