<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VerticeMobile"
             x:Class="VerticeMobile.SaleDetailPage"
             Title="Detalle de Venta">

    <CollectionView x:Name="cvItems" SelectionMode="None" Margin="15,0">

        <CollectionView.Header>
            <Border BackgroundColor="#f8f9fa" Padding="15" Margin="0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="lblTitle" FontSize="20" FontAttributes="Bold" TextColor="#333" />
                    <Label x:Name="lblDate" FontSize="14" TextColor="#555" />
                    <Label x:Name="lblPayment" FontSize="14" TextColor="#555" />
                    <Label x:Name="lblSession" FontSize="14" TextColor="#555" />
                    <Label x:Name="lblFiscal" FontSize="14" />

                    <BoxView HeightRequest="1" Color="#E0E0E0" Margin="0,6" />

                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto, Auto" RowSpacing="2">
                        <Label Grid.Row="0" Grid.Column="0" Text="Subtotal productos" FontSize="14" TextColor="#555" />
                        <Label Grid.Row="0" Grid.Column="1" x:Name="lblSubTotal" FontSize="14" TextColor="#555" />
                        <Label Grid.Row="1" Grid.Column="0" x:Name="lblAdjustmentTitle" FontSize="14" TextColor="#555" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="lblAdjustment" FontSize="14" TextColor="#555" />
                        <Label Grid.Row="2" Grid.Column="0" Text="Total" FontSize="18" FontAttributes="Bold" TextColor="Green" />
                        <Label Grid.Row="2" Grid.Column="1" x:Name="lblTotal" FontSize="18" FontAttributes="Bold" TextColor="Green" />
                        <Label Grid.Row="3" Grid.Column="0" Text="Ganancia" FontSize="15" FontAttributes="Bold" TextColor="#1565c0" />
                        <Label Grid.Row="3" Grid.Column="1" x:Name="lblProfit" FontSize="15" FontAttributes="Bold" TextColor="#1565c0" />
                    </Grid>

                    <Label Text="Productos" FontSize="16" FontAttributes="Bold" TextColor="#333" Margin="0,10,0,0" />
                </VerticalStackLayout>
            </Border>
        </CollectionView.Header>

        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="local:SaleItemRow">
                <Border Padding="10" Margin="0,4" StrokeShape="RoundRectangle 6" BackgroundColor="White" Stroke="#E0E0E0">
                    <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                        <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="15" TextColor="#333" />
                        <Label Grid.Row="1" Grid.Column="0" Text="{Binding Detail}" FontSize="12" TextColor="Gray" />
                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding SubTotal, StringFormat='{0:C2}'}" FontAttributes="Bold" FontSize="15" TextColor="Green" HorizontalOptions="End" />
                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding ProfitText}" FontSize="12" TextColor="#1565c0" HorizontalOptions="End" />
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
