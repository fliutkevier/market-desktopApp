<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VerticeMobile.Controls"
             xmlns:local="clr-namespace:VerticeMobile"
             x:Class="VerticeMobile.SalesPage"
             Title="Ventas">

    <!-- Todo sale de la copia local: funciona igual con o sin conexión.
         Deslizar hacia abajo trae lo nuevo de la PC. -->
    <Grid RowDefinitions="Auto, *">

        <controls:StatusBanner Grid.Row="0" />

        <RefreshView Grid.Row="1" x:Name="refreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="cvSales"
                            SelectionMode="Single"
                            SelectionChanged="OnSaleSelected"
                            Margin="15,0">

                <CollectionView.Header>
                    <VerticalStackLayout Spacing="10" Padding="0,10,0,5">

                        <!-- FILTROS -->
                        <Border BackgroundColor="#f8f9fa" Padding="12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                                    <Picker Grid.Column="0" x:Name="pkPeriod" Title="Período" SelectedIndexChanged="OnFilterChanged" />
                                    <Picker Grid.Column="1" x:Name="pkFiscal" Title="Facturación" SelectedIndexChanged="OnFilterChanged" />
                                </Grid>

                                <Grid x:Name="gridCustomDates" ColumnDefinitions="Auto, *, Auto, *" ColumnSpacing="6" IsVisible="False">
                                    <Label Grid.Column="0" Text="Desde" VerticalOptions="Center" TextColor="#555" />
                                    <DatePicker Grid.Column="1" x:Name="dpFrom" Format="dd/MM/yyyy" DateSelected="OnDateChanged" />
                                    <Label Grid.Column="2" Text="Hasta" VerticalOptions="Center" TextColor="#555" />
                                    <DatePicker Grid.Column="3" x:Name="dpTo" Format="dd/MM/yyyy" DateSelected="OnDateChanged" />
                                </Grid>

                                <Picker x:Name="pkPayment" Title="Medio de pago" SelectedIndexChanged="OnFilterChanged" />
                                <Picker x:Name="pkSession" Title="Caja" SelectedIndexChanged="OnFilterChanged" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- RESUMEN -->
                        <Border BackgroundColor="#e8f5e9" Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="4">
                                <Label x:Name="lblTotal" FontSize="26" FontAttributes="Bold" TextColor="#1B5E20" />
                                <Label x:Name="lblCount" FontSize="14" TextColor="#555" />

                                <BoxView HeightRequest="1" Color="#C8E6C9" Margin="0,6" />

                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Ganancia" FontSize="16" FontAttributes="Bold" TextColor="#1565c0" />
                                    <Label Grid.Row="0" Grid.Column="1" x:Name="lblProfit" FontSize="16" FontAttributes="Bold" TextColor="#1565c0" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="Costo de lo vendido" FontSize="14" TextColor="#c62828" />
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="lblCost" FontSize="14" TextColor="#c62828" />
                                    <Label Grid.Row="2" Grid.Column="0" Text="Varios / Fiambrería (sin costo)" FontSize="14" TextColor="#555" />
                                    <Label Grid.Row="2" Grid.Column="1" x:Name="lblVarios" FontSize="14" TextColor="#555" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#C8E6C9" Margin="0,6" />

                                <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Facturado" FontSize="14" TextColor="#333" />
                                    <Label Grid.Row="0" Grid.Column="1" x:Name="lblInvoiced" FontSize="14" TextColor="#333" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="Pendiente ARCA" FontSize="14" TextColor="#E65100" />
                                    <Label Grid.Row="1" Grid.Column="1" x:Name="lblPending" FontSize="14" TextColor="#E65100" />
                                    <Label Grid.Row="2" Grid.Column="0" Text="Sin facturar" FontSize="14" TextColor="#333" />
                                    <Label Grid.Row="2" Grid.Column="1" x:Name="lblNotInvoiced" FontSize="14" TextColor="#333" />
                                </Grid>

                                <BoxView HeightRequest="1" Color="#C8E6C9" Margin="0,6" />

                                <!-- Por medio de pago -->
                                <VerticalStackLayout x:Name="stackByPayment" Spacing="2">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="local:PaymentTotalRow">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="{Binding Label}" FontSize="14" TextColor="#333" />
                                                <Label Grid.Column="1" Text="{Binding Total, StringFormat='{0:C2}'}" FontSize="14" TextColor="#333" />
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Button Text="Ver productos vendidos" Clicked="OnProductRankingClicked" BackgroundColor="#9C27B0" TextColor="White" />

                        <Label x:Name="lblListTitle" FontSize="18" FontAttributes="Bold" TextColor="#333" Margin="0,8,0,0" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <Label Text="No hay ventas con estos filtros." TextColor="Gray" HorizontalTextAlignment="Center" Margin="20" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:SaleRow">
                        <Border Padding="10" Margin="0,4" StrokeShape="RoundRectangle 6" BackgroundColor="#f8f9fa">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Title}" FontAttributes="Bold" FontSize="15" TextColor="#333" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Subtitle}" FontSize="12" TextColor="Gray" />
                                <Label Grid.Row="2" Grid.Column="0" Text="{Binding FiscalText}" FontSize="12" TextColor="{Binding FiscalColor}" />

                                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Total, StringFormat='{0:C2}'}" FontAttributes="Bold" FontSize="16" TextColor="Green" HorizontalOptions="End" />
                                <Label Grid.Row="1" Grid.Column="1" Text="{Binding Profit, StringFormat='Gan. {0:C0}'}" FontSize="12" TextColor="#1565c0" HorizontalOptions="End" />
                                <Label Grid.Row="2" Grid.Column="1" Text="{Binding ItemsText}" FontSize="12" TextColor="#666" HorizontalOptions="End" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
