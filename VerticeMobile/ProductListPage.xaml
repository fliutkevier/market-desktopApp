<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VerticeMobile.Controls"
             x:Class="VerticeMobile.ProductListPage"
             Title="Buscar por Nombre">

    <Grid RowDefinitions="Auto, Auto, *">

        <controls:StatusBanner Grid.Row="0" />

        <!-- Barra de búsqueda -->
        <SearchBar Grid.Row="1"
                   x:Name="searchBar"
                   Margin="15,10,15,0"
                   Placeholder="Ej: Coca Cola, Alfajor..."
                   TextChanged="OnSearchTextChanged"
                   CancelButtonColor="Red" />

        <!-- Lista de productos (sale de la copia local; deslizar hacia abajo trae lo nuevo de la PC) -->
        <RefreshView Grid.Row="2" x:Name="refreshView" Refreshing="OnRefreshing" Margin="15,0">
            <CollectionView x:Name="cvProducts"
                            SelectionMode="Single"
                            SelectionChanged="OnProductSelected">
                <CollectionView.EmptyView>
                    <Label x:Name="lblEmpty" Text="No hay productos guardados. Conéctese a la PC del local y deslice hacia abajo para actualizar."
                           TextColor="Gray" HorizontalTextAlignment="Center" Margin="20" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10" Margin="0,5" StrokeShape="RoundRectangle 5" BackgroundColor="#f8f9fa">
                            <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">
                                <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="16" TextColor="#333" />
                                <Label Grid.Row="1" Grid.Column="0" Text="{Binding Code}" FontSize="12" TextColor="Gray" />

                                <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" HorizontalOptions="End" VerticalOptions="Center">
                                    <Label Text="{Binding SalePrice, StringFormat='{0:C0}'}" FontAttributes="Bold" TextColor="Green" FontSize="16" HorizontalOptions="End" />
                                    <Label Text="{Binding Stock, StringFormat='Stock: {0}'}" FontSize="12" TextColor="#666" HorizontalOptions="End" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
